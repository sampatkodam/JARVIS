GEMINI_API_KEY=
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_WORKSPACE=./workspace
JARVIS_COMMAND_TIMEOUT=60
JARVIS_MAX_OUTPUT_CHARS=12000
# Required: exact immutable sandbox image reference, e.g. registry.example/jarvis-sandbox@sha256:<64-hex-digest>
JARVIS_SANDBOX_IMAGE=
JARVIS_SANDBOX_MEMORY=1g
JARVIS_SANDBOX_CPUS=2.0
JARVIS_SANDBOX_PIDS=256
JARVIS_SANDBOX_NETWORK=none
JARVIS_SANDBOX_SIGNING_POLICY=config/sandbox-signing-policy.json
# Required by the signing policy: filesystem path to the trusted Cosign public key
JARVIS_SANDBOX_COSIGN_PUBLIC_KEY=
